# ═══════════════════════════════════════════════
#  PakSentiment Docker Environment Variables
#  Docker Compose reads this file automatically.
#  Copy this to .env and fill in your real values.
# ═══════════════════════════════════════════════

# ── JWT & Auth ──
JWT_SECRET=please-change-me-in-production
JWT_EXPIRES_IN=1h

# ── Google OAuth ──
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# ── API Keys ──
GROQ_API_KEY=your-groq-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ── Ollama LLM ──
OLLAMA_URL=your_Ai_model_endpoint
OLLAMA_MODEL=phi3:mini

# ── Stripe / PayPal (Frontend) ──
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample
NEXT_PUBLIC_PAYPAL_CLIENT_ID=sb

# ── Database Credentials ──
POSTGRES_USER=paksentiment
POSTGRES_PASSWORD=paksentiment
POSTGRES_DB=paksentiment
 