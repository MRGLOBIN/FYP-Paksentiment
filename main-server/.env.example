# Main server (NestJS)
PORT=3000
NODE_ENV=development

# JWT for issuing access tokens
JWT_SECRET=please-change-me
JWT_EXPIRES_IN=1h

# Google OAuth
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# FastAPI gateway base URL
FAST_API_BASE_URL=http://localhost:8000

# (Future) database connection placeholder
DATABASE_URL=postgresql://user:password@localhost:5432/paksentiment

GROQ_API_KEY=your-groq-api-key-here

# Go Colly Sidecar
COLLY_SIDECAR_URL=http://localhost:8081

# Ollama LLM (primary sentiment engine)
OLLAMA_URL=your_Ai_model_endpoint
OLLAMA_MODEL=your_model_name
